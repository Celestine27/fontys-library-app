@page
@using library_app.Models
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Library</h1>
    <table class="table table-striped">
        <tr>
            <th>Name</th>
            <th>Creator</th>
            <th>Total Chapters</th>
            <th>Medium</th>
            <th>Total Pages</th>
            <th>Total Volumes</th>
            <th>Actions</th>
        </tr>

        @foreach (Title title in Model.Titles)
        {
            <tr>
                <td>@title.Name</td>
                <td>@title.Creator</td>
                <td>@title.TotalChapters</td>
                @if (title is Book book)
                {
                    <td>Book</td>
                    <td>@(book.TotalPages?.ToString() ?? "-")</td>
                    <td>-</td>
                }
                else if (title is Manga manga)
                {
                    <td>Manga</td>
                    <td>-</td>
                    <td>@(manga.TotalVolumes?.ToString() ?? "-")</td>
                }
                <td>
                    <a asp-page="/Titles/Edit" asp-route-id="@title.Id" class="btn btn-secondary btn-sm">Edit</a>
                    
                    <form method="post" asp-page-handler="Delete" asp-route-id="@title.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this title?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>
    <a asp-page="/Titles/Create" class="btn btn-primary mb-3">Add title</a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-message" class="alert alert-success mt-2">
            @TempData["SuccessMessage"]
        </div>

        <script>
            setTimeout(function () {
                const message = document.getElementById("success-message");
                if (message) {
                    message.remove();
                }
            }, 3000);
        </script>
    }
</div>