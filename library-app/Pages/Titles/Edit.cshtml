@page
@model library_app.Pages.Titles.Edit

@{
    ViewData["Title"] = "Edit Title";
}

<h1>Edit Title</h1>
<p>Type: <strong>@Model.TitleRequest.SelectedType</strong></p>

<div class="row">
    <div class="col-md-6">
        <form method="post">
        <input type="hidden" asp-for="TitleRequest.Id"/>
        <input type="hidden" asp-for="TitleRequest.SelectedType"/>

        <div class="mb-3">
            <label class="form-label" asp-for="TitleRequest.Name">Name</label>
            <input class="form-control" asp-for="TitleRequest.Name"/>
            <span class="text-danger" asp-validation-for="TitleRequest.Name"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="TitleRequest.Creator">Creator</label>
            <input class="form-control" asp-for="TitleRequest.Creator"/>
            <span class="text-danger" asp-validation-for="TitleRequest.Creator"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="TitleRequest.Isbn">Isbn</label>
            <input class="form-control" asp-for="TitleRequest.Isbn"/>
            <span class="text-danger" asp-validation-for="TitleRequest.Isbn"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="TitleRequest.TotalChapters">Total Chapters</label>
            <input class="form-control" asp-for="TitleRequest.TotalChapters"/>
            <span class="text-danger" asp-validation-for="TitleRequest.TotalChapters"></span>
        </div>

        @if (Model.TitleRequest.SelectedType == "Book")
        {
            <div class="mb-3">
                <label class="form-label" asp-for="TitleRequest.TotalPages">Total Pages</label>
                <input class="form-control" asp-for="TitleRequest.TotalPages"/>
                <span class="text-danger" asp-validation-for="TitleRequest.TotalPages"></span>
            </div>
        }
        else if (Model.TitleRequest.SelectedType == "Manga")
        {
            <div class="mb-3">
                <label class="form-label" asp-for="TitleRequest.TotalVolumes">Total Volumes</label>
                <input class="form-control" asp-for="TitleRequest.TotalVolumes"/>
                <span class="text-danger" asp-validation-for="TitleRequest.TotalVolumes"></span>
            </div>
        }

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </form>
    </div>
</div>