@page
@using library_app.Models
@model library_app.Pages.Titles.Create

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<body>
<h1>Add Title</h1>

<form method="post">
    <div>
        <label asp-for="Name">Name</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Creator">Creator</label>
        <input asp-for="Creator" />
        <span asp-validation-for="Creator"></span>
    </div>
    <div>
        <label asp-for="Isbn">Isbn</label>
        <input asp-for="Isbn" />
        <span asp-validation-for="Isbn"></span>
    </div>
    <div>
        <label asp-for="TotalChapters">Total Chapters</label>
        <input asp-for="TotalChapters" />
        <span asp-validation-for="TotalChapters"></span>
    </div>
    <div>
        <label asp-for="SelectedType">Type</label>
        <select asp-for="SelectedType">
            <option value="">-- Choose a type --</option>
            <option value="Book">Book</option>
            <option value="Manga">Manga</option>
        </select>
        <span asp-validation-for="SelectedType"></span>
    </div>

    <div id="pages-field" style="display: none;">
        <label asp-for="TotalPages">Total Pages</label>
        <input asp-for="TotalPages" />
        <span asp-validation-for="TotalPages"></span>
    </div>

    <div id="volumes-field" style="display: none;">
        <label asp-for="TotalVolumes">Total Volumes</label>
        <input asp-for="TotalVolumes" />
        <span asp-validation-for="TotalVolumes"></span>
    </div>

    <button type="submit">Save</button>
</form>

<script>
    const typeSelect = document.getElementById("SelectedType");
    const pagesField = document.getElementById("pages-field");
    const volumesField = document.getElementById("volumes-field");

    function updateFields() {
        pagesField.style.display = typeSelect.value === "Book" ? "block" : "none";
        volumesField.style.display = typeSelect.value === "Manga" ? "block" : "none";
    }

    typeSelect.addEventListener("change", updateFields);
    updateFields();
</script>
</body>
</html>